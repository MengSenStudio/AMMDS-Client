# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 安装包产物目录（scripts/build_installer.ps1 输出，不入库）
/dist/

# Widget Preview related
.widget_preview/

# third_party 中的依赖兼容补丁副本需要提交（见 third_party/README.md），
# 仅忽略其内部的构建与工具产物。
/third_party/**/.dart_tool/
/third_party/**/build/
/third_party/**/demo_tool/

